+export function handleError(err: { code: string }) {
+  // BUG: SDK contract is 'UserCancelled' (PascalCase), not 'user-cancelled' (kebab)
+  if (err.code === 'user-cancelled') {
+    return 'cancelled';
+  }
+  if (err.code === 'time-out') {
+    return 'timeout';
+  }
+}
