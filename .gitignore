# Secrets — NEVER commit these
*.env
*.env.local
.env
.env.*
!.env.example

# The actual settings.json may contain MCP credentials/URLs you don't want shared.
# Only the .example version is committed.
dotfiles/claude/settings.json

# Memory files — these may contain personal notes you don't want pushed.
# If you want to sync memory across machines, decide explicitly per-file.
dotfiles/claude/memory/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Python (review_plan_v2 module + tests)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
# Local venv + editable-install metadata. `pip install -e '.[dev]'` writes
# scripts/review_plan_v2.egg-info/, and the suite has to be run from a venv
# because macOS `python3` is 3.9 and pyproject declares >=3.10 (tests/conftest.py
# enforces it). Declared HERE rather than in ~/.gitignore_global on purpose: a
# global ignore is for machine state, and a `lib/` line in that file is what cost
# this repo three months of misdiagnosis on the cascade fixtures.
.venv/
# Version-suffixed siblings for verifying the FLOOR of requires-python. `.venv`
# tracks whatever is current (3.13 today); `>=3.10` is only a real claim if the
# suite is run on 3.10, and a `.venv/` line alone leaves `.venv310/` untracked-
# but-visible, which is how a throwaway venv gets committed.
.venv3*/
*.egg-info/
# setuptools scratch from `pip install .[dev]` (as opposed to `-e`), which the
# 3.10 floor venv uses.
build/

# review-plan-v2 runtime state lives outside the repo (~/.claude/review-plan-v2/)
# — no in-repo gitignore needed. Per-test temp state is colocated with each test repo.

# Claude Code's local state — not portable across machines
.claude/cache/
.claude/projects/
.claude/shell-snapshots/
.claude/todos/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks/
# Per ADR-0007 this repo doesn't need a per-project allowlist; user-scope
# baseline cascades. Keep settings.local.json out of git so CR CLI and
# git status stop re-flagging it.
.claude/settings.local.json

# The Copilot upload zips are committed on purpose (spec 004): people download
# them from the public mirror, and tests/unit/test_copilot_zip.py fails if one
# differs from a fresh build. A global `dist/` ignore would otherwise hide them.
!/dist/
